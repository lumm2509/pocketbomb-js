{
  "name": "@pocketbomb/example-core",
  "version": "0.0.0",
  "private": true,
  "description": "Vanilla TypeScript example: a storefront page (public key + customer login) and a Node.js script (private key + request context).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start:node": "node src/node.ts",
    "smoke": "node ../../scripts/pocketbomb-server.ts --seed ../../scripts/example-fixtures.ts -- node src/node.ts"
  },
  "dependencies": {
    "@pocketbomb/dynamite": "workspace:^",
    "@pocketbomb/primer": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
