{
  "name": "pocketbomb-detcord",
  "version": "0.2.0",
  "description": "The App Bridge of the PocketBomb embedded applications: session tokens, navigation sync, toasts, modals, title bar and resize over postMessage with the dashboard (browser only, no dependencies).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumm2509/pocketbomb-js.git",
    "directory": "packages/detcord"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  }
}
