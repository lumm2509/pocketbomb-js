{
  "name": "@pocketbomb/primer",
  "version": "0.1.0",
  "description": "PocketBomb transport: API keys and tokens, auth stores, OAuth2 account strategy, records REST, GraphQL, realtime and file URLs (browser, Node.js, edge, React Native).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumm2509/pocketbomb-js.git",
    "directory": "packages/primer"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal/index.d.ts",
        "default": "./dist/internal/index.js"
      },
      "require": {
        "types": "./dist/internal/index.d.cts",
        "default": "./dist/internal/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
